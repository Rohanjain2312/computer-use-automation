# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Required for `cua discover` only. Replay never calls a model. ---
ANTHROPIC_API_KEY=sk-ant-...
CUA_MODEL=claude-sonnet-5

# --- Credentials for the target application ---
# These are fixture values for the local mock console. They are read from the
# environment at run time and are never written into artifacts, logs or evidence.
MERIDIAN_OPERATOR_ID=ops.demo
MERIDIAN_OPERATOR_PASSCODE=demo-not-a-real-password

# Supervisor override code used by the human-in-the-loop demo. The operator
# supplies this; it never appears in the repository.
MERIDIAN_OVERRIDE_CODE=OVR-4417

# --- Where the mock console runs ---
MERIDIAN_BASE_URL=http://127.0.0.1:8799
