    {
      "rule": "session_timeout",
      "step_id": "s04_open_member_servicing_look_up_memb",
      "attempt": 1,
      "during": "wait",
      "applied": true,
      "then": "resume_from_step",
      "detail": "If the operator session has expired, navigating to any function (e.g. Member Servicing) shows a \"Session Ended\" dialog stating \"Your session has expired.\" and \"Sign on again to continue.\" with a \"Return to Sign On\" button. Unlike a simple interstitial, clearing this does not resume the interrupted step in place \u2014 it returns to the Operator Sign On screen, so a replay that encounters this must restart the entire flow from sign-on (operator id + passcode) rather than retrying the step that noticed the timeout. Restarts the flow from the entry point, because dismissing this screen alone leaves the session unauthenticated."
    },
    {
      "rule": "system_maintenance_notice",
      "step_id": "s04_open_member_servicing_look_up_memb",
      "attempt": 1,
      "during": "wait",
      "applied": true,
      "then": "retry_step",
      "detail": "After signing on and before the first Member Servicing search, a \"System Notice\" interstitial appears announcing a scheduled maintenance window. It is shown once per sign-on and is cleared by clicking the \"Acknowledge and Continue\" button, after which the requested Member Servicing screen loads normally."
    }
